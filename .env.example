# SDK 选择 openai 或 anthropic。
AI_SDK=openai

# 所有 SDK 使用同一组变量。AI_BASE_URL 留空时使用所选 SDK 的官方地址。
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

SESSION_SECRET=replace-with-a-long-random-secret
# SESSION_SECRET 用于签名会话 cookie。若留空,启动时会自动生成进程级随机值。
# 正式部署请固定此值,否则每次重启会让所有现有会话失效。
ALLOWED_ORIGIN=http://localhost:5173
DAILY_AI_ATTEMPT_LIMIT=300
DAILY_AI_ATTEMPT_LIMIT_PER_SESSION=30

# SAM3 文字分割。令牌只保存在服务端；留空时使用公开匿名连接。
SAM_PROVIDER=hf-gradio
SAM_SPACE_URL=https://prithivmlmods-sam3-demo.hf.space
SAM_HF_TOKEN=
SAM_TIMEOUT_MS=75000
# 公开 SAM3 Demo 尚未提供点坐标与独立蒙版输出，保持 false。
# 自建或获授权的提供方实现 /segment_points 后才开启。
SAM_POINT_SEGMENTATION=false
SAM_POINT_ENDPOINT=/segment_points
DAILY_SAM_ATTEMPT_LIMIT=60
DAILY_SAM_ATTEMPT_LIMIT_PER_SESSION=6
