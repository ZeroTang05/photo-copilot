# AI provider selection: "openai" or "anthropic" (default: openai).
# Anthropic path uses tool_use with input_schema, which most Anthropic-compatible
# services (incl. MiniMax) handle well. OpenAI path uses json_object + repair
# retry; strict json_schema is OpenAI-only and not universally honored.
AI_PROVIDER=openai

# OpenAI / OpenAI-compatible (DeepSeek, vLLM, Azure OpenAI, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Anthropic / Anthropic-compatible (Anthropic direct, MiniMax, Bedrock proxy, etc.)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# When AI_PROVIDER=anthropic, AI_MODEL above is reused. Examples:
#   claude-3-5-sonnet-latest   (Anthropic)
#   MiniMax-M3                  (MiniMax Anthropic-compatible endpoint)

SESSION_SECRET=replace-with-a-long-random-secret
# SESSION_SECRET 用于签名会话 cookie。若留空,启动时会自动生成进程级随机值。
# 正式部署请固定此值,否则每次重启会让所有现有会话失效。
ALLOWED_ORIGIN=http://localhost:5173
DAILY_AI_ATTEMPT_LIMIT=300
DAILY_AI_ATTEMPT_LIMIT_PER_SESSION=30